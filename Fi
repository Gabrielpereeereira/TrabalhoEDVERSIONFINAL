    private void atualizar() {

        try {

            Lista lista =
                    repository.buscarTodosComLista();

            boolean encontrou = false;

            for(int i=0;i<lista.size();i++) {

                Inscricao ins =
                        (Inscricao) lista.get(i);

                if(ins.getCodigoProcesso().equals(
