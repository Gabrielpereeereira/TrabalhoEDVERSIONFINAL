        try {

            Fila fila =
                    repository.buscarPorCodigoProcessoComFila(
                            view.getTxtCodigoProcesso()
                                    .getText()
                                    .trim());

            if(fila.isEmpty()) {

                view.getTxtResultado()
                        .setText("Inscrição não encontrada");

                return;
